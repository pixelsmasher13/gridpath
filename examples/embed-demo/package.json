{
  "name": "gridpath-embed-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:recording": "tsc --project tsconfig.recording.json --noEmit",
    "recording": "npm --prefix ../../packages/grid run build && VITE_RECORDING=1 VITE_SITE=1 vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "build:site": "VITE_SITE=1 vite build --base /demo/ --outDir ../../marketing/demo --emptyOutDir",
    "preview": "vite preview"
  },
  "dependencies": {
    "gridpath": "file:../../packages/gridpath/gridpath-0.5.2.tgz",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
