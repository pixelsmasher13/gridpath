# ──────────────────────────────────────────────────────────────────
# REQUIRED — proxy won't start / auth won't work without these
# ──────────────────────────────────────────────────────────────────

# Firebase Admin SDK (verifies ID tokens minted by the desktop app)
FIREBASE_PROJECT_ID=gridpath
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@gridpath.iam.gserviceaccount.com

# Anthropic — primary LLM provider for Cursor-for-Excel
CLAUDE_API_KEY=sk-ant-...

# Internal session signing (any 32+ char random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Postgres connection string — used by lib/db.ts via `pg`. User records,
# LLM usage rows, credit balances. (Supabase Postgres works fine; the
# JS client isn't used — only the raw connection string.)
DATABASE_URL=postgresql://...

# ──────────────────────────────────────────────────────────────────
# REQUIRED FOR BILLING — set when wiring up Stripe subscription
# ──────────────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ──────────────────────────────────────────────────────────────────
# REQUIRED FOR EMAIL FLOWS — password reset, email verification
# ──────────────────────────────────────────────────────────────────

RESEND_API_KEY=re_...

# ──────────────────────────────────────────────────────────────────
# OPTIONAL — only set if you actually use these LLM providers
# ──────────────────────────────────────────────────────────────────

# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROK_API_KEY=xai-...
# GOOGLE_VERTEX_API_KEY=...

# Internal server-to-server bypass (lets one service call another
# without a Firebase token). Only needed if you add cron/scheduled
# jobs back. Leave unset for Gridpath's app-only flow.
# INTERNAL_SERVICE_KEY=...

# ──────────────────────────────────────────────────────────────────
# Standard
# ──────────────────────────────────────────────────────────────────

NODE_ENV=production
CLIENT_URL=http://localhost:5173
